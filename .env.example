# App
APP_NAME=Smart Assessment Tool
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Database (configure before running database-backed features)
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/smart_assessment

# LLM provider (set only the provider you use)
LLM_PROVIDER=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
LLM_MODEL=

# n8n integration
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Security: replace with a long random value
APP_SECRET_KEY=replace-with-a-long-random-secret
